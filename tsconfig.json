{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react",
		"jsxFactory": "h",
		"jsxFragmentFactory": "Fragment",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"sourceMap": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"useDefineForClassFields": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"mutts": [
				"mutts/src/index.ts"
			],
			"mutts/*": [
				"mutts/src/*"
			],
			"pounce-ts": [
				"pounce-ts/src/lib/index.ts"
			],
			"pounce-ts/*": [
				"pounce-ts/*"
			],
			"pure-glyf": [
				"pure-glyf/src/index.ts"
			],
			"pure-glyf/*": [
				"pure-glyf/src/*"
			],
			"npc-script": [
				"../npcs/src/index.ts"
			],
			"omni18n": [
				"../omni18n/src/client.ts"
			]
		}
	},
	"include": [
		"src/**/*",
		"../pounce/src/types/**/*.d.ts",
		"../mutts/**/*.ts",
		"tests/dockview.test.tsx",
		"pure-glyf.d.ts"
	],
	"references": [
		{
			"path": "./tsconfig.node.json"
		}
	]
}